{
  "name": "@workel/mcp",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Official Model Context Protocol server for Workel \u2014 a thin client of the Workel Public API v1",
  "main": "dist/index.js",
  "bin": {
    "workel-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/remote.*",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "workel",
    "ai",
    "agents"
  ],
  "author": "Workel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WorkelCEO/workel-mcp.git"
  },
  "homepage": "https://developer.workel.com/#mcp",
  "bugs": {
    "url": "https://developer.workel.com"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.3",
    "wrangler": "^4.126.0"
  }
}
